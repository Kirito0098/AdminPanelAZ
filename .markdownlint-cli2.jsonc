{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": ["a", "details", "summary", "strong"]
    },
    "MD060": false
  },
  "ignores": [
    ".cursor/**",
    ".superpowers/**",
    "docs/plans/**",
    "frontend/node_modules/**",
    "frontend/dist/**",
    "backend/.venv/**"
  ],
  "overrides": [
    {
      "files": ["CHANGELOG.md"],
      "config": {
        "MD013": false
      }
    }
  ]
}
