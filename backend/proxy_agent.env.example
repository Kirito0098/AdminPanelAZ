# Proxy agent environment (создаётся при установке на RU-хосте, не коммитить)
PROXY_AGENT_API_KEY=change-me-proxy-agent-key
# Production: openssl rand -hex 32 (минимум 24 символа)
# PROXY_AGENT_ALLOWED_IPS=10.0.0.5/32
PROXY_AGENT_HOST=0.0.0.0
PROXY_AGENT_PORT=9101
PROXY_AGENT_STATE_DIR=/var/lib/adminpanelaz-proxy
PROXY_AGENT_MODE=prod
# mTLS (опционально, см. scripts/generate-mtls-certs.sh):
# PROXY_AGENT_MTLS_ENABLED=false
# PROXY_AGENT_MTLS_SERVER_CERT=/etc/adminpanelaz/mtls/agent.crt
# PROXY_AGENT_MTLS_SERVER_KEY=/etc/adminpanelaz/mtls/agent.key
# PROXY_AGENT_MTLS_CA_CERT=/etc/adminpanelaz/mtls/ca.crt
