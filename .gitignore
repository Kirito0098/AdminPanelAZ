# =============================================================================
# AdminPanelAZ — не коммитить runtime, секреты и артефакты сборки
# Основные пути: backend/data/ (DATABASE_URL), backend/.env, .runtime/
# =============================================================================

# --- Secrets & environment (шаблоны *.env.example остаются в git) ---
.env
.env.*
*.env
!*.env.example
!**/.env.example
ddns.env
.reinstall-backup/

# --- SQLite & runtime databases (WAL mode включён в database.py) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# --- Runtime data: backend/data/ (primary — sqlite:///./data/ относительно backend/) ---
backend/data/

# --- Legacy runtime data: repo root data/ ---
/data/

# GeoIP MMDB (пользователь загружает сам; см. docs/GeoIP.md)
*.mmdb

# --- CIDR pipeline (legacy / дублирующие пути) ---
backend/app/data/

# --- mTLS / crypto material (generate-mtls-certs.sh → /etc/adminpanelaz по умолчанию) ---
*.pem
*.key
*.crt
*.p12
*.pfx

# --- Backup archives & temp payloads (backup-cli, restore, pipeline) ---
*.tar.gz
*.tar
.tmp_*

# --- Локальные планы агента (не часть продукта) ---
/plans/

# --- Python ---
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node / frontend builds ---
frontend/node_modules/
frontend/dist/
frontend/dist.next/
frontend/dist.old/
frontend/.vite/
backend/app/static/tg_mini/
backend/app/static/tg_mini.next/
backend/app/static/tg_mini.old/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime logs, PIDs, local state (.runtime/ или ADMINPANELAZ_STATE_DIR) ---
.runtime/
*.log

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# --- Cline: .clineignore — локальная настройка автозагрузки контекста (не коммитить) ---
.clineignore

# --- Agents: AGENTS.md, правила и скиллы в git; локальный MCP/bin — нет ---
.agents/*
!.agents/AGENTS.md
!.agents/rules/
!.agents/rules/**
# Личная синхронизация с Gitea — только на сервере, в репозиторий не попадает
.agents/rules/gitea-agent-sync.md
!.agents/skills/
!.agents/skills/**
.agents/skills/**/__pycache__/
!.agents/skills-*/
!.agents/skills-*/**
!.agents/skills-lock.json
!.agents/mcp.json.example
!.agents/mcp_config.json.example
.agents/mcp.json
.agents/mcp_settings.json
.agents/bin/
.agents/**/__pycache__/

# --- Local screenshot tooling (credentials / panel URL — not for repo) ---
scripts/capture-readme-screenshots.mjs

# --- Graphify code graph (локальная индексация MCP, не для repo) ---
graphify-out/

# --- Agent SDD scratch (ledgers / briefs / reviews; not for repo) ---
.superpowers/
docs/superpowers/

# --- OpenCode agent workspace (local config, memory, plans; not for repo) ---
.opencode/

# Root-level skills lock from global `npx skills` (project lock is .agents/skills-lock.json)
/skills-lock.json

# --- Local implementation plans (owner-only; not for public repo) ---
docs/plans/

# Local accidental venv at repo root
.venv/
.worktrees/
